[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://vault/translations/001.en_US.translation", "res://vault/translations/001.id_ID.translation", "res://vault/translations/002.en_US.translation", "res://vault/translations/002.id_ID.translation", "res://vault/translations/003.en_US.translation", "res://vault/translations/003.id_ID.translation", "res://vault/translations/004.en_US.translation", "res://vault/translations/004.id_ID.translation", "res://vault/translations/chloe/dialogue_translation.en_US.translation", "res://vault/translations/chloe/dialogue_translation.fr_FR.translation", "res://vault/translations/chloe/translation2.en_US.translation", "res://vault/translations/chloe/translation2.fr_FR.translation", "res://vault/translations/chloe/translation.en_US.translation", "res://vault/translations/chloe/translation.fr_FR.translation")
